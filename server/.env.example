PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/campuscoin
# Optional local override for Atlas SRV lookups; Vercel uses its managed DNS by default.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# ---- Email / SMTP (for password reset and report sharing) ----
# Gmail setup (recommended for testing):
#   1. Enable 2-Step Verification at https://myaccount.google.com/security
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail" → copy the 16-character password
#   4. Set the values below (use the App Password, NOT your Gmail password)
#
# Leave SMTP_HOST blank for development mode: reset links are printed to the
# server console instead of sent by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Campus Coin <no-reply@campuscoin.app>

ADMIN_EMAIL=admin@campuscoin.app
ADMIN_PASSWORD=Admin@123

# ---- AI writer (DeepSeek) ----
# Optional. Used only for the monthly summary; leave the key blank and the
# summary is generated locally by services/insights.js instead.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# off | on | auto. Thinking is on by default at the API; `off` suits short summaries.
DEEPSEEK_THINKING=off

# ---- Vision AI (Scan Receipt) ----
# Required for the "Scan Receipt" feature.
# Option 1 (Recommended & Free): Google Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option 2: OpenAI API key (gpt-4o-mini / gpt-4o) from https://platform.openai.com
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini
